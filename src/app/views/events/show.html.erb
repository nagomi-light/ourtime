<div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md">
  <div class="p-6">
    <h1 class="font-bold text-4xl">予定の詳細</h1>
    <h2>タイトル <%= @event.title %></h2>
    <p>説明 <%= @event.description %></p>
    <p>開始時刻 <%= @event.start_time %></p>
    <p>終了時刻 <%= @event.end_time %></p>
  </div>
  
  <nav>
    <%= link_to "予定表に戻る", events_path, class: "bg-blue-500 text-white px-6 py-2 rounded hover:bg-blue-600" %>
  </nav>
  <nav>
    <%= link_to "編集する", edit_event_path, class: "bg-blue-500 text-white px-6 py-2 rounded hover:bg-blue-600" %>
  </nav>
  <nav>
    <%= link_to "削除する", event_path, method: :delete, data: { confirm: "この予定を削除します。よろしいですか？" }, class: "bg-red-500 text-white px-6 py-2 rounded hover:bg-red-600" %>
  </nav>
</div>
