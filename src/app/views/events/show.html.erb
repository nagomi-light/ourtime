<div class="max-w-3xl mx-auto mt-10 p-4 md:p-6 bg-white rounded-lg shadow-md">
  <div class="border-b border-gray-200 pb-4 mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:justify-between md:items-end">
      <h1 class="text-2xl font-bold">
        <%= @event.title %>
      </h1>

      <div class="text-gray-900 text-sm whitespace-nowrap">
        <!-- 繰り返しの有無 -->
        <p>
          <% if @event.repeat_label.present? %>
            <<%= @event.repeat_label %>>
          <% end %>
        </p>
        
        <!-- 予定の時間 -->
        <p>
          <% if @event.all_day %>
            <%= "#{@event.start_time.strftime("%Y/%m/%d")}～#{@event.end_time.strftime("%Y/%m/%d")}" %>
          <% else %>
            <%= "#{@event.start_time.strftime("%Y/%m/%d %H:%M")}～#{@event.end_time.strftime("%Y/%m/%d %H:%M")}" %>
          <% end %>
        </p>
      </div>
    </div>
  </div>

  <div class="mb-4">
    <p class="block text-gray-700 font-medium mb-2">説明</p>
    <div class="border border-gray-300 rounded px-3 py-2 whitespace-pre-wrap min-h-[100px]"><%= @event.description.presence %></div>
  </div>

  <div class="mb-6">
    <p class="block text-gray-700 font-medium mb-2">チーム</p>
    <div class="border border-gray-300 rounded px-3 py-2">
      <%= @event.team&.name || "なし" %>
    </div>
  </div>

  <div class="flex justify-between items-center mt-8 pt-6 border-t border-gray-200">
    <div class="flex gap-4">
      <% if @event.user == current_user %>
        <%= link_to "編集",
            edit_event_path(@event),
            class: "bg-blue-500 text-white px-3 md:px-6 py-2 rounded hover:bg-blue-600" %>

        <%= button_to "削除",
            event_path(@event),
            method: :delete,
            data: { turbo_confirm: "本当に削除しますか？" },
            class: "bg-red-500 text-white px-3 md:px-6 py-2 rounded hover:bg-red-600" %>
      <% end %>
    </div>

    <%= link_to "戻る",
        events_path,
        class: "px-3 md:px-6 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-100" %>
  </div>

</div>