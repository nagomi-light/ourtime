<div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md">
  <h1 class="border-b border-gray-200 pb-4 text-2xl font-bold mb-6 text-center">
    パスワードの設定
  </h1>

  <p class="text-gray-700 text-center mb-8">
    パスワードを設定して利用を開始してください。
  </p>

  <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :put }) do |f| %>
    <%= f.hidden_field :invitation_token, readonly: true %>
      <% if f.object.class.require_password_on_accepting %>
        <!-- パスワード -->
        <div class="mb-4">
          <%= f.label :password, "パスワード", class: "block text-gray-700 font-medium mb-2" %>
          <%= f.password_field :password,
            class: "
              w-full rounded px-3 py-2 
              focus:outline-none focus:ring
              #{resource.errors[:password].any? ?
                'border border-red-500 focus:border-red-500 focus:ring-red-200' :
                'border border-gray-300 focus:border-blue-500'}
            " %>
          <div class="h-2 mt-1">
            <% if resource.errors[:password].any? %>
              <p class="text-xs text-red-600">
                ※パスワード<%= resource.errors[:password].first %>
              </p>
            <% end %>
          </div>
        </div>
        

        <!-- パスワードの確認 -->
        <div class="mb-4">
          <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-gray-700 font-medium mb-2" %>
          <%= f.password_field :password_confirmation,
            class: "
              w-full rounded px-3 py-2 
              focus:outline-none focus:ring
              #{resource.errors[:password_confirmation].any? ?
                'border border-red-500 focus:border-red-500 focus:ring-red-200' :
                'border border-gray-300 focus:border-blue-500'}
            " %>
          <div class="h-5 mt-1">
            <% if resource.errors[:password_confirmation].any? %>
              <p class="text-xs text-red-600">
                ※パスワード（確認）<%= resource.errors[:password_confirmation].first %>
              </p>
            <% end %>
          </div>
        </div>
        
      


        <div class="flex gap-4 mt-8 pt-6 border-t border-gray-200">
          <%= f.submit "利用開始",
              class: "bg-blue-500 text-white px-6 py-2 rounded hover:bg-blue-600" %>
        </div>
      <% end %>
    <% end %>
</div>









