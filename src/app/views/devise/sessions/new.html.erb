<div class="max-w-3xl mx-auto mt-2 md:mt-10 p-4 md:p-6 bg-white rounded-lg shadow-md">
  <h1 class="border-b border-gray-200 pb-4 text-xl md:text-2xl font-bold mb-6 text-center">
    ログイン
  </h1>

  <% if flash[:alert] %>
    <div class="mb-4 rounded border border-red-300 bg-red-50 p-3 text-red-700">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <!-- メールアドレス -->
    <div class="mb-4">
      <%= f.label :email, "メールアドレス", class: "block text-gray-700 font-medium mb-2" %>
      <%= f.email_field :email,
        autocomplete: "email",
        class: "
          w-full rounded px-3 py-2 
          focus:outline-none focus:ring border border-gray-300 focus:border-blue-500
        " %>
    </div>

    <!-- パスワード -->
    <div class="mb-4">
      <%= f.label :password, "パスワード", class: "block text-gray-700 font-medium mb-2" %>
      <%= f.password_field :password,
        autocomplete: "current-password",
        class: "
          w-full rounded px-3 py-2 
          focus:outline-none focus:ring border border-gray-300 focus:border-blue-500
        " %>
    </div>
    
    <% if devise_mapping.rememberable? %>
      <div class="field">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "ログインしたままにする" %>
      </div>
    <% end %>


    <div class="flex justify-between gap-4 mt-8 pt-6 border-t border-gray-200">
      <%= f.submit "ログイン",
          class: "bg-blue-500 text-white px-3 md:px-6 py-2 rounded hover:bg-blue-600" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>




