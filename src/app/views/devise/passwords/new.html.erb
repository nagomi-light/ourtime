<div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md">
  <h1 class="border-b border-gray-200 pb-4 text-2xl font-bold mb-6 text-center">
    パスワードの再設定
  </h1>

  <p class="text-gray-700 text-center mb-8">
    パスワードを再設定するためのメールを送信します。
  </p>

  <% if flash[:alert] %>
    <div class="mb-4 rounded border border-red-300 bg-red-50 p-3 text-red-700">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <!-- メールアドレス -->
    <div class="mb-4">
      <%= f.label :email, "登録済みのメールアドレス", class: "block text-gray-700 font-medium mb-2" %>
      <%= f.email_field :email,
        autocomplete: "email",
        class: "
          w-full rounded px-3 py-2 
          focus:outline-none focus:ring border border-gray-300 focus:border-blue-500
        " %>
    </div>


    <div class="flex justify-between gap-4 mt-8 pt-6 border-t border-gray-200">
      <%= f.submit "送信",
          class: "bg-blue-500 text-white px-6 py-2 rounded hover:bg-blue-600" %>
      <%= link_to "キャンセル", request.referer || root_path,
          class: "px-6 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-100" %>
    </div>
  <% end %>

</div>
