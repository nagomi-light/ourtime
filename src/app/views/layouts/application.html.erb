<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-cache-control" content="no-cache">
    <!-- <meta name="turbo-visit-control" content="reload"> -->
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&display=swap" rel="stylesheet">

    <% unless Rails.env.test? %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
      <%= stylesheet_link_tag "fullcalendar/main", "data-turbo-track": "reload" %>
      <%= stylesheet_link_tag "fullcalendar/daygrid", "data-turbo-track": "reload" %>
    <% end %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <header class="bg-sky-500 flex justify-between items-center px-6 py-3 shadow">
  
      <!-- 左：ロゴ -->
      <div class="text-3xl text-white" style="font-family: 'Luckiest Guy', cursive;">
        <%= link_to "OUR TIME", root_path, class: "hover:opacity-80 transition" %>
      </div>

      <!-- 右：ログイン・ログアウト -->
      <% if user_signed_in? %>
        <div class="relative inline-block w-40" data-controller="dropdown">

          <!-- トリガー -->
          <button
            data-action="click->dropdown#toggle"
            data-dropdown-target="button"
            class="flex items-center justify-between w-full px-3 py-2
                  bg-white text-black border border-gray-200
                  rounded-md hover:bg-gray-100 transition"
          >
            <div class="flex items-center gap-2">
              <!-- ユーザーのアイコン -->
              <svg xmlns="http://www.w3.org/2000/svg"
                   viewBox="0 0 24 24"
                   fill="none" 
                   stroke-width="1.5" stroke="currentColor"
                   class="w-6 h-6 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>

              <!-- ユーザー名 -->
              <span class="hidden sm:block truncate">
                <%= current_user.name %>
              </span>
            </div>
    
            <!-- ドロップダウンのアイコン -->
            <svg xmlns="http://www.w3.org/2000/svg" 
                 viewBox="0 0 24 24" 
                 fill="currentColor" 
                 class="w-4 h-4 text-gray-400 transition-transform duration-200">
              <path fill-rule="evenodd" d="M12.53 16.28a.75.75 0 0 1-1.06 0l-7.5-7.5a.75.75 0 0 1 1.06-1.06L12 14.69l6.97-6.97a.75.75 0 1 1 1.06 1.06l-7.5 7.5Z" clip-rule="evenodd" />
            </svg>
  
          </button>

          <!-- メニュー -->
          <div
            data-dropdown-target="menu"
            id="user-menu"
            class="hidden absolute top-full right-0 mt-4 w-full
                  bg-gray-200 border border-gray-200 shadow-md
                  rounded-md overflow-hidden z-50"
          >
            <!-- カレンダー -->
            <%= link_to root_path,
                class: "flex items-center gap-2 px-4 py-2 hover:bg-gray-100 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke-width="1.5" stroke="currentColor"
                  class="w-5 h-5 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
              <span>カレンダー</span>
            <% end %>
            <div class="border-t mx-2"></div>

            <!-- 管理者用メニュー -->
            <% if current_user.admin == true %>
              <!-- チーム管理 -->
              <%= link_to admin_teams_path,
                  class: "flex items-center gap-2 px-4 py-2 hover:bg-gray-100 transition" do %>
                <svg xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke-width="1.5" stroke="currentColor"
                    class="w-5 h-5 shrink-0">
                  <path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.372.568A12.696 12.696 0 0 1 12 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 0 1-.372-.568 6.787 6.787 0 0 1 1.019-4.38Z" clip-rule="evenodd" />
                  <path d="M5.082 14.254a8.287 8.287 0 0 0-1.308 5.135 9.687 9.687 0 0 1-1.764-.44l-.115-.04a.563.563 0 0 1-.373-.487l-.01-.121a3.75 3.75 0 0 1 3.57-4.047ZM20.226 19.389a8.287 8.287 0 0 0-1.308-5.135 3.75 3.75 0 0 1 3.57 4.047l-.01.121a.563.563 0 0 1-.373.486l-.115.04c-.567.2-1.156.349-1.764.441Z" />
                </svg>
                <span>チーム管理</span>
              <% end %>
              <div class="border-t mx-2"></div>

              <!-- ユーザー管理 -->
              <%= link_to admin_users_path,
                  class: "flex items-center gap-2 px-4 py-2 hover:bg-gray-100 transition" do %>
                <svg xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke-width="1.5" stroke="currentColor"
                    class="w-5 h-5 shrink-0">
                  <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
                </svg>
                <span>ユーザー管理</span>
              <% end %>
              <div class="border-t mx-2"></div>
            <% end %>

            <!-- パスワード変更 -->
            <%= link_to edit_user_registration_path,
                class: "flex items-center gap-2 px-4 py-2 hover:bg-gray-100 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke-width="1.5" stroke="currentColor"
                  class="w-5 h-5 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
              </svg>
              <span>パスワード変更</span>
            <% end %>
            <div class="border-t mx-2"></div>

            <!-- ログアウト -->
            <%= button_to destroy_user_session_path,
                method: :delete,
                form: { class: "w-full" },
                data: { turbo_confirm: "ログアウトしますか？" },
                class: "w-full flex items-center gap-2 px-4 py-2 hover:bg-gray-100 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-5 h-5 shrink-0">
                <path fill-rule="evenodd" d="M16.5 3.75a1.5 1.5 0 0 1 1.5 1.5v13.5a1.5 1.5 0 0 1-1.5 1.5h-6a1.5 1.5 0 0 1-1.5-1.5V15a.75.75 0 0 0-1.5 0v3.75a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V5.25a3 3 0 0 0-3-3h-6a3 3 0 0 0-3 3V9A.75.75 0 1 0 9 9V5.25a1.5 1.5 0 0 1 1.5-1.5h6ZM5.78 8.47a.75.75 0 0 0-1.06 0l-3 3a.75.75 0 0 0 0 1.06l3 3a.75.75 0 0 0 1.06-1.06l-1.72-1.72H15a.75.75 0 0 0 0-1.5H4.06l1.72-1.72a.75.75 0 0 0 0-1.06Z" clip-rule="evenodd" />
              </svg>
              <span>ログアウト</span>
            <% end %>
          </div>

        </div>
      <% else %>
        <!-- ログイン -->
        <%= link_to new_user_session_path,
            class: "flex items-center gap-2 px-4 py-2 text-white hover:opacity-80 transition" do %>
          <svg xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5 shrink-0">
            <path fill-rule="evenodd" d="M7.5 3.75A1.5 1.5 0 0 0 6 5.25v13.5a1.5 1.5 0 0 0 1.5 1.5h6a1.5 1.5 0 0 0 1.5-1.5V15a.75.75 0 0 1 1.5 0v3.75a3 3 0 0 1-3 3h-6a3 3 0 0 1-3-3V5.25a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3V9A.75.75 0 0 1 15 9V5.25a1.5 1.5 0 0 0-1.5-1.5h-6Zm5.03 4.72a.75.75 0 0 1 0 1.06l-1.72 1.72h10.94a.75.75 0 0 1 0 1.5H10.81l1.72 1.72a.75.75 0 1 1-1.06 1.06l-3-3a.75.75 0 0 1 0-1.06l3-3a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
          </svg>
          <span>ログイン</span>
        <% end %>
      <% end %>
      
    </header>

    <main class="container mx-auto mt-9 px-5">
      <% if flash[:notice] %>
        <div class="bg-green-100 text-green-800 px-4 py-2 rounded mb-4">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
