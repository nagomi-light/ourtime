<div>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl md:text-2xl font-bold">チーム管理</h1>
    <%= link_to "新規チームの作成",
        new_admin_team_path,
        class: "bg-blue-500 text-white px-3 md:px-6 py-2 rounded hover:bg-blue-600 text-xs md:text-base" %>
  </div>

  <div class="space-y-4">
  <% @teams.each do |team| %>

    <div class="bg-white border border-gray-200 rounded-2xl p-4 md:p-6
                hover:shadow-md hover:border-blue-300 transition"
         id="team-<%= team.id %>">

      <div class="flex items-center justify-between">

        <!-- 左：チームの情報 -->
        <div class="flex items-center gap-3 md:gap-4 min-w-0">

          <!-- アイコン -->
          <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-blue-100
                      flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke-width="1.5" stroke="currentColor"
                 class="w-5 h-5 shrink-0">
              <path fill-rule="evenodd" d="M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.372.568A12.696 12.696 0 0 1 12 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 0 1-.372-.568 6.787 6.787 0 0 1 1.019-4.38Z" clip-rule="evenodd" />
              <path d="M5.082 14.254a8.287 8.287 0 0 0-1.308 5.135 9.687 9.687 0 0 1-1.764-.44l-.115-.04a.563.563 0 0 1-.373-.487l-.01-.121a3.75 3.75 0 0 1 3.57-4.047ZM20.226 19.389a8.287 8.287 0 0 0-1.308-5.135 3.75 3.75 0 0 1 3.57 4.047l-.01.121a.563.563 0 0 1-.373.486l-.115.04c-.567.2-1.156.349-1.764.441Z" />
            </svg>
          </div>

          <!-- チーム名・メンバー -->
          <div>

            <h2 class="text-lg font-bold text-gray-900">
              <%= team.name %>
            </h2>

            <p class="text-sm text-gray-500 mt-1">
              <%= team.users.count %>人のメンバー
            </p>

            <p class="text-sm text-gray-400 mt-2 break-words">
              <%= team.users.limit(5).map(&:name).join(" / ") %>

              <% if team.users.count > 5 %>
                +<%= team.users.count - 5 %>
              <% end %>
            </p>

          </div>
        </div>

        <!-- 右：操作ボタン -->
        <div class="flex flex-col items-center gap-2 md:flex-row md:gap-3">
          <!-- チームの編集ボタン -->
          <%= link_to edit_admin_team_path(team),
              class: "w-9 h-9 md:w-10 md:h-10 rounded-xl border border-gray-300
                      flex items-center justify-center
                      hover:bg-gray-100 transition" do %>
            <svg xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke-width="1.5" stroke="currentColor"
                      class="w-5 h-5 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
            </svg>
          <% end %>

          <!-- チームの削除ボタン -->
          <%= link_to admin_team_path(team),
              data: {
                turbo_method: :delete,
                turbo_confirm: "削除しますか？"
              },
              class: "w-9 h-9 md:w-10 md:h-10 rounded-xl border border-red-200
                      text-red-500 flex items-center justify-center
                      hover:bg-red-50 transition" do %>
            <svg xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke-width="1.5" stroke="currentColor"
                  class="w-5 h-5 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>